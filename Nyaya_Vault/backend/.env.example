APP_ENV=development
DEBUG=false
EXPOSE_DOCS=true

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Recommended current keys from Supabase Project Settings → API Keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SERVER ONLY. Never put this key in React or commit it.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy projects may use SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY instead.
STORAGE_BUCKET=case-documents

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=26214400
PROCESSING_TIMEOUT_SECONDS=180
PROCESSING_LEASE_SECONDS=300

ENABLE_SEMANTIC_EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
