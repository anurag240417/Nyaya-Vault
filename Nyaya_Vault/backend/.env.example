APP_ENV=development
DEBUG=false
EXPOSE_DOCS=true

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Recommended current keys from Supabase Project Settings → API Keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SERVER ONLY. Never put this key in React or commit it.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy projects may use SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY instead.
STORAGE_BUCKET=case-documents

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=26214400
PROCESSING_TIMEOUT_SECONDS=180
PROCESSING_LEASE_SECONDS=300

ENABLE_SEMANTIC_EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# AI case assistant (ask/summary/legal-section-suggestion features).
# Set OPENAI_API_KEY to use OpenAI (used first if both are set).
# Leave both unset to disable - those endpoints return a clear error
# rather than silently doing nothing.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.openai.com/v1

# Blockchain anchoring of the audit chain (integrity/anchors endpoints).
# Anchors the current audit-chain head to a public testnet by sending a
# zero-value transaction whose data field is the anchor payload - no smart
# contract needed. Leave ENABLE_BLOCKCHAIN_ANCHOR=false (or leave the RPC
# URL/private key unset) to disable; those endpoints then report
# enabled:false / return a clear "not configured" error instead of doing
# nothing silently.
#
# To try it: create a throwaway wallet, fund it with free Polygon Amoy
# testnet MATIC from a faucet (search "Polygon Amoy faucet"), and put its
# private key below. NEVER reuse a wallet that holds anything of real value.
ENABLE_BLOCKCHAIN_ANCHOR=false
# The old rpc-amoy.polygon.technology endpoint has been unreliable/unresolvable
# for some networks - polygon-amoy.drpc.org is a verified-working alternative
# (also try polygon-amoy-bor-rpc.publicnode.com or
# polygon-amoy.gateway.tenderly.co if this one is ever down).
BLOCKCHAIN_RPC_URL=https://polygon-amoy.drpc.org
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_NETWORK_NAME=Polygon Amoy Testnet
BLOCKCHAIN_EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx/

