# Set APP_ENV=production when deployed: turns on HSTS and force-disables the
# /docs, /redoc and /openapi.json pages regardless of EXPOSE_DOCS.
APP_ENV=development
DEBUG=false
EXPOSE_DOCS=true

# Rate limiting (per client IP, in-memory per process) and security headers.
# Defaults are fine for most setups. Strict bucket covers expensive calls
# (document processing, certificates/notices, AI assistant, anchoring).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_STRICT_PER_MINUTE=20
# Only true behind a reverse proxy that overwrites X-Forwarded-For, or every
# request looks like it comes from the proxy's IP and shares one allowance.
TRUST_PROXY_HEADERS=false
SECURITY_HEADERS_ENABLED=true

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Recommended current keys from Supabase Project Settings → API Keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SERVER ONLY. Never put this key in React or commit it.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Legacy projects may use SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY instead.
STORAGE_BUCKET=case-documents

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_BYTES=26214400
PROCESSING_TIMEOUT_SECONDS=180
PROCESSING_LEASE_SECONDS=300

ENABLE_SEMANTIC_EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Semantic search (blended into /api/v1/search alongside keyword search via
# reciprocal rank fusion - see backend/README.md "Semantic search"). Needs
# ENABLE_SEMANTIC_EMBEDDINGS=true too, or there are no vectors to search.
# Leave ENABLE_PGVECTOR_SEARCH=false to use a pure-Python fallback that
# needs no extra setup; set it true only after running
# supabase/optional/pgvector.sql (indexed, scales to real document volume).
ENABLE_PGVECTOR_SEARCH=false

# AI case assistant (ask/summary/legal-section-suggestion features).
# Set OPENAI_API_KEY to use OpenAI (used first if both are set).
# Leave both unset to disable - those endpoints return a clear error
# rather than silently doing nothing.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.openai.com/v1

# Blockchain anchoring of the audit chain (integrity/anchors endpoints).
# Anchors the current audit-chain head to a public testnet by sending a
# zero-value transaction whose data field is the anchor payload - no smart
# contract needed. Leave ENABLE_BLOCKCHAIN_ANCHOR=false (or leave the RPC
# URL/private key unset) to disable; those endpoints then report
# enabled:false / return a clear "not configured" error instead of doing
# nothing silently.
#
# To try it: create a throwaway wallet, fund it with free Polygon Amoy
# testnet MATIC from a faucet (search "Polygon Amoy faucet"), and put its
# private key below. NEVER reuse a wallet that holds anything of real value.
# Digital signatures on certificates/notices: each user gets an ECDSA P-256
# keypair on first use; the private key is stored encrypted with this
# secret. Optional - falls back to deriving one from SUPABASE_SECRET_KEY,
# but set it independently so one leaked secret doesn't expose both.
# Changing it later makes previously-issued keys undecryptable.
SIGNING_KEY_ENCRYPTION_SECRET=

ENABLE_BLOCKCHAIN_ANCHOR=false
# The old rpc-amoy.polygon.technology endpoint has been unreliable/unresolvable
# for some networks - polygon-amoy.drpc.org is a verified-working alternative
# (also try polygon-amoy-bor-rpc.publicnode.com or
# polygon-amoy.gateway.tenderly.co if this one is ever down).
BLOCKCHAIN_RPC_URL=https://polygon-amoy.drpc.org
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_NETWORK_NAME=Polygon Amoy Testnet
BLOCKCHAIN_EXPLORER_TX_BASE_URL=https://amoy.polygonscan.com/tx/

# Automatic anchoring on a schedule (background task in this process; needs
# the settings above working). Skips a run when nothing but anchor entries
# were logged since the last anchor, so an idle system spends no gas.
# Run ONE backend instance with this on, or each instance anchors separately.
AUTO_ANCHOR_ENABLED=false
AUTO_ANCHOR_INTERVAL_SECONDS=3600
AUTO_ANCHOR_INITIAL_DELAY_SECONDS=30

